#!/usr/bin/env bash
# Tiny shortcut for the webuntis-agent CLI (no venv / PYTHONPATH needed).
#
# Usage: ./wu search "Erika Muster"
#        ./wu students find "Erika Muster"
#        ./wu --help
#
# Override the interpreter if needed: PYTHON_BIN=/path/to/python ./wu ...
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"

export PYTHONPATH="${ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
exec "$PYTHON_BIN" -m webuntis_agent.cli "$@"
